{
  "routes": [
    {
      "routePath": "/api/verify/:id",
      "mountPath": "/api/verify",
      "method": "GET",
      "module": [
        "api/verify/[id].ts:onRequestGet"
      ]
    },
    {
      "routePath": "/api/auth",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/auth.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/certificates",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/certificates.ts:onRequestPost"
      ]
    }
  ],
  "baseURL": "/"
}